#
# Emit a C byte array from a binary file. Run in CMake script mode, so turning a
# blob into something a sample can #include costs no tool the build did not
# already require:
#
#   cmake -DBIN=<in> -DHEADER=<out> -DARRAY=<name> [-DALIGN=<n>] [-DFROM=<text>]
#         -P bin2c.cmake

foreach(_required BIN HEADER ARRAY)
  if(NOT ${_required})
    message(FATAL_ERROR "bin2c.cmake: -D${_required}= is required")
  endif()
endforeach()
if(NOT ALIGN)
  set(ALIGN 4)
endif()
if(NOT FROM)
  set(FROM "${BIN}")
endif()

file(READ "${BIN}" _hex HEX)
string(REGEX MATCHALL ".." _bytes "${_hex}")
list(LENGTH _bytes _count)
if(_count EQUAL 0)
  message(FATAL_ERROR "bin2c.cmake: ${BIN} is empty - nothing to emit")
endif()

# Eight bytes to a line, tab-indented, to read like a hand-written table.
set(_body "")
set(_line "")
set(_column 0)
foreach(_byte IN LISTS _bytes)
  if(_column EQUAL 0)
    set(_line "\t0x${_byte},")
  else()
    set(_line "${_line} 0x${_byte},")
  endif()
  math(EXPR _column "${_column} + 1")
  if(_column EQUAL 8)
    string(APPEND _body "${_line}\n")
    set(_line "")
    set(_column 0)
  endif()
endforeach()
if(NOT _column EQUAL 0)
  string(APPEND _body "${_line}\n")
endif()

file(WRITE "${HEADER}"
"/*
 * SPDX-License-Identifier: LicenseRef-Nordic-5-Clause
 *
 * GENERATED by bin2c.cmake from ${FROM} - do not edit, and do not commit.
 * ${_count} bytes, aligned to ${ALIGN}.
 */

static const uint8_t ${ARRAY}[] __attribute__((aligned(${ALIGN}))) = {
${_body}};
")
message(STATUS "bin2c: ${HEADER} (${_count} bytes)")
